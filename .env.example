# Owner connection — runs migrations only. Never used to serve requests.
DATABASE_URL=postgres://localhost:5432/openparking_dev

# Application connection — NOSUPERUSER, NOBYPASSRLS. Everything else uses this.
APP_DATABASE_URL=postgres://openparking_app:openparking_dev_password@localhost:5432/openparking_dev

# Password applied to the app role by `npm run ensure-app-role`.
APP_DB_PASSWORD=openparking_dev_password

PORT=3000

# How far ahead of this server's clock a lane may timestamp an entry or an exit
# before the call is refused. Optional; leave it unset unless a fleet's clocks
# are worse than that. The default is in src/app.js and is not repeated here,
# because two copies of a number are two numbers.
# MAX_CLOCK_SKEW_SECONDS=

# Where rate-engine answers. REQUIRED to price: the close route hands every
# plan of the garage to the engine's POST /v1/quote and freezes the answer;
# with no engine reachable a close answers 500 and the lane retries it. The
# plan store validates every plan with POST /v1/validate-plan before storing
# it; unset or unreachable, storing is refused by name. See README, "Rate
# plans" and "The close prices through the engine".
# RATE_ENGINE_URL=http://127.0.0.1:8080

# The two entitlement modules the close consults before pricing (0015). Their
# DSNs are THEIRS -- garage-pass and monthly-billing read these themselves;
# this platform passes its environment through and never reads them. Only
# needed once a garage states a link to that module. ENTITLEMENT_BIN_DIR names
# the directory holding the two console scripts; unset, they are found on PATH.
# GARAGE_PASS_DSN=host=127.0.0.1 port=5432 dbname=garage_pass user=garage_pass_app password=...
# MONTHLY_BILLING_DSN=host=127.0.0.1 port=5432 dbname=monthly_billing user=monthly_billing_app password=...
# ENTITLEMENT_BIN_DIR=/opt/openparking/venv/bin
