# Owner connection — runs migrations only. Never used to serve requests.
DATABASE_URL=postgres://localhost:5432/openparking_dev

# Application connection — NOSUPERUSER, NOBYPASSRLS. Everything else uses this.
APP_DATABASE_URL=postgres://openparking_app:openparking_dev_password@localhost:5432/openparking_dev

# Password applied to the app role by `npm run ensure-app-role`.
APP_DB_PASSWORD=openparking_dev_password

PORT=3000

# How far ahead of this server's clock a lane may timestamp an entry or an exit
# before the call is refused. Optional; leave it unset unless a fleet's clocks
# are worse than that. The default is in src/app.js and is not repeated here,
# because two copies of a number are two numbers.
# MAX_CLOCK_SKEW_SECONDS=
