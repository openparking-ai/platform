# A superuser on the cluster, for `npm run prepare-database` only -- the one
# step that needs one (README, "The one step that needs a superuser").
SUPERUSER_URL=postgres://postgres@localhost:5432

# Owner connection — runs migrations only. Never used to serve requests.
# NOSUPERUSER and NOBYPASSRLS; `npm run prepare-database` makes it if missing.
DATABASE_URL=postgres://openparking_owner:openparking_owner_dev_password@localhost:5432/openparking_dev

# Application connection — NOSUPERUSER, NOBYPASSRLS. Everything else uses this.
APP_DATABASE_URL=postgres://openparking_app:openparking_dev_password@localhost:5432/openparking_dev

# Password applied to the app role by `npm run prepare-database`.
APP_DB_PASSWORD=openparking_dev_password

# PORT 1..65535 and PG_POOL_MAX 1..100, like MAX_CLOCK_SKEW_SECONDS
# below, are plain whole numbers inside their ranges, or the server does not
# start (src/startSettings.js).
PORT=3000

# How far ahead of this server's clock a lane may timestamp an entry or an exit
# before the call is refused, 0..3600 seconds. Optional; leave it unset unless a
# fleet's clocks are worse than that. The default is in src/startSettings.js and
# is not repeated here, because two copies of a number are two numbers.
# MAX_CLOCK_SKEW_SECONDS=

# Where rate-engine answers. REQUIRED to price: the close route hands every
# plan of the garage to the engine's POST /v1/quote and freezes the answer;
# with no engine reachable a close answers 500 and the lane retries it. The
# plan store validates every plan with POST /v1/validate-plan before storing
# it; unset or unreachable, storing is refused by name. See README, "Rate
# plans" and "The close prices through the engine".
# RATE_ENGINE_URL=http://127.0.0.1:8080

# The two entitlement modules the close consults before pricing (0015). Their
# DSNs are THEIRS -- garage-pass and monthly-billing read these themselves;
# this platform passes its environment through and never reads them. Only
# needed once a garage states a link to that module. ENTITLEMENT_BIN_DIR names
# the directory holding the two console scripts; unset, they are found on PATH.
# GARAGE_PASS_DSN=host=127.0.0.1 port=5432 dbname=garage_pass user=garage_pass_app password=...
# MONTHLY_BILLING_DSN=host=127.0.0.1 port=5432 dbname=monthly_billing user=monthly_billing_app password=...
# ENTITLEMENT_BIN_DIR=/opt/openparking/venv/bin

# The owner's sign-in (0024). ADMIN_ORIGIN is the admin site's origin,
# scheme://host[:port], served SAME-ORIGIN as /api (the cookie is Path=/api,
# no Domain, SameSite=Strict, and there is no CORS). Unset, owner sign-in is off
# (409 sign_in_not_configured). A cookie-authenticated request that changes
# something must carry this Origin. See README, "The owner signs in".
# ADMIN_ORIGIN=https://admin.example.com
# Every number below is a whole number inside its range, or serve refuses to
# start, naming the setting and the range.
# Sessions end 30 minutes after their last use and 12 hours after sign-in.
# Idle 1..1440 minutes, never longer than the end; the end 1..168 hours.
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12
# The cookie is Secure. Exactly "true" turns that off, for plain-http local
# development ONLY; serve says so out loud.
# SESSION_COOKIE_INSECURE=
# The caller address sign-in counts against is the socket's. Behind a proxy,
# declare it here or every caller is the proxy and one lock is everyone's. One
# of: a number of proxy hops, 1..5; "loopback"; or a comma-separated list of
# the proxies' addresses or subnets (CIDR). "true", and every other form, is
# refused: it trusts whatever the caller says. A number of hops must EQUAL the
# real number of proxies in front of this server; larger, and a caller's forged
# X-Forwarded-For chooses the address the lock and the limit count.
# TRUST_PROXY=
# Sign-in attempts per caller address (1..1000) per window (1..1440 minutes),
# held in this process.
# SIGN_IN_ATTEMPTS_PER_ADDRESS=30
# SIGN_IN_ATTEMPTS_WINDOW_MINUTES=15
# No sign-in refusal is answered sooner than this after the request arrived,
# 200..5000 ms: above a refusal's own work (one hash, about 151 ms measured),
# so the work is not on the wire.
# SIGN_IN_REFUSAL_FLOOR_MS=500
# Sign-ins waiting for, or running, their hash (1..1000), and how many of them
# one address may hold (1..16, not more than the line). A full line answers
# 503 sign_in_busy at once. 48 places at about 26 hashes a second is about
# 2 seconds of waiting at worst.
# SIGN_IN_HASH_LINE=48
# SIGN_IN_HASH_LINE_PER_ADDRESS=2
# The four doors behind an emailed link -- invite status and accept, forgot,
# reset (0032) -- each count their own attempts per caller address (1..1000)
# per window (1..1440 minutes), held in this process.
# ACCOUNT_LINK_ATTEMPTS_PER_ADDRESS=10
# ACCOUNT_LINK_ATTEMPTS_WINDOW_MINUTES=60

# Email (0032): the invite, the reset link, and the notice that an invite was
# accepted. The key is in a FILE, mounted as a secret, never in the
# environment. KEY_FILE and FROM are set together or not at all; unset, no
# email is sent: invite-admin refuses, and serve says email is off. A key file
# that is named and cannot be read refuses to start. No address is written in
# this repository: each is a setting. EMAIL_API_URL defaults to Resend's.
# EMAIL_KEY_FILE=/run/secrets/email_api_key
# EMAIL_FROM=Open Parking <invites@example.com>
# EMAIL_NOTICE_TO=someone@example.com
# EMAIL_API_URL=

# The validations module the close and the reader may ask (0019), named by its
# command: a bare command name, found in ENTITLEMENT_BIN_DIR or on PATH. There
# is NO default. Unset, this deployment has no validations module: stating a
# validations link is refused by name (409 validations_not_configured) and no
# door is ever run; a garage that already links one cannot be answered for and
# takes the could-not-decide path. Its own DSN is the module's, not this
# platform's. See README, "A validation at the exit".
# VALIDATIONS_DOOR=

# A garage's own Stripe account, created through Stripe Connect (0020). All
# three, or the Connect routes answer that this deployment has none configured
# and ask Stripe nothing. The key is this deployment's own; a restricted key
# holding only the grants the calls need is the right kind. The URLs are where
# Stripe sends an operator back from onboarding, and where it sends one whose
# link expired. Values are never written into this repository.
# STRIPE_API_KEY=
# CONNECT_RETURN_URL=
# CONNECT_REFRESH_URL=
